{
  "title": "cachic",
  "uid": "cachic",
  "tags": [
    "cachic",
    "lancache",
    "cache"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Hit ratio by service",
      "description": "The number the cache exists to move. A service sitting near zero is either newly seen or not actually being cached.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (cdn_service) (rate(cachic_requests_total{status=\"HIT\"}[5m])) / clamp_min(sum by (cdn_service) (rate(cachic_requests_total[5m])), 0.001)",
          "legendFormat": "{{cdn_service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Bytes served vs fetched",
      "description": "Served is what clients got; fetched is what we paid the internet for. The gap between them is the value of the cache.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(cachic_bytes_served_total[5m]))",
          "legendFormat": "served to clients",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(rate(cachic_bytes_fetched_total[5m]))",
          "legendFormat": "fetched from origins",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Silently dropped disk writes",
      "description": "THE PANEL TO WATCH. Non-zero means writes are outrunning the disk and the cache is declining to store content while still serving clients at full speed. Clients see no error and the hit ratio simply never improves. Raise flushers and the buffer pool, or slow the fill.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(foyer_storage_inner_op_total{op=\"channel_overflow\"}[5m]))",
          "legendFormat": "channel overflow",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(rate(foyer_storage_block_engine_op_total{op=\"enqueue_skip\"}[5m]))",
          "legendFormat": "enqueue skip",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Checksum failures",
      "description": "Slices that failed verification on read. Should be exactly zero. Non-zero means the storage underneath is returning bad bytes; the slice is refetched rather than served, so this is a storage alarm, not a correctness breach.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(cachic_checksum_failures_total[5m]))",
          "legendFormat": "{{cdn_service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Generation bumps",
      "description": "Objects invalidated because their validators changed upstream. A steady trickle is normal. A spike means a CDN is rewriting content, and every bump costs a refetch.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(cachic_generation_bumps_total[5m]))",
          "legendFormat": "{{cdn_service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Upstream fetch latency",
      "description": "How long origins take. The p99 is what a cold client feels.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(cachic_upstream_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cachic_upstream_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "In-flight fetches and connections",
      "description": "In-flight fetches approaching UPSTREAM_MAX_INFLIGHT means requests are queueing on upstream capacity.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "cachic_upstream_inflight",
          "legendFormat": "upstream in flight",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "cachic_client_connections",
          "legendFormat": "client connections",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Requests by cache status",
      "description": "MISS on a warm cache means new content. PARTIAL means a range spanning cached and uncached slices, which is normal mid-fill.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(cachic_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Guard refusals",
      "description": "Upstream fetches refused because the resolved address was private, loopback or reserved. A steady rate means something on the LAN is asking the cache to fetch from inside the network.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(cachic_upstream_guard_refusals_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Request latency",
      "description": "End-to-end service time, which is what a client actually experiences. Distinct from upstream latency: a cache hit never touches the origin, so a rise here with flat upstream latency points at the store or at writing to the client.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, cdn_service) (rate(cachic_request_seconds_bucket[5m])))",
          "legendFormat": "p50 {{cdn_service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, cdn_service) (rate(cachic_request_seconds_bucket[5m])))",
          "legendFormat": "p99 {{cdn_service}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Responses by status code",
      "description": "HTTP status, which is a different question from cache status. A burst of 5xx is invisible in the cache-status panels.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(cachic_responses_total[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Upstream failures and stale responses",
      "description": "Why the origin is failing, and whether the cache is covering for it. Stale responses climbing means clients are being served through an outage they cannot see - good, but you should know.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(cachic_upstream_errors_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(rate(cachic_stale_responses_total[5m]))",
          "legendFormat": "stale served",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Cache occupancy and the disk guard",
      "description": "How full the cache is against the cap it is allowed to use. When cachic_disk_guard_engaged is 1 the free-space guard has clamped the configured size and the cache will not grow further.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "cachic_index_bytes",
          "legendFormat": "indexed",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "cachic_store_capacity_bytes",
          "legendFormat": "capacity after guard",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "cachic_disk_available_bytes",
          "legendFormat": "filesystem free",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "cachic_disk_guard_engaged",
          "legendFormat": "guard engaged (0/1)",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Upstream saturation per service",
      "description": "In-flight upstream fetches against each service's configured ceiling (FR-09). Touching the limit means that CDN is the bottleneck, not the cache.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 36,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "cachic_upstream_inflight_service",
          "legendFormat": "{{cdn_service}} in flight",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "cachic_upstream_limit_service",
          "legendFormat": "{{cdn_service}} limit",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Drain",
      "description": "Requests still being served, and whether shutdown is waiting on them. A drain that does not reach zero is a stuck request, and the pod will be killed rather than exiting cleanly.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "cachic_requests_in_flight",
          "legendFormat": "in flight",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "cachic_draining",
          "legendFormat": "draining (0/1)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    }
  ]
}
